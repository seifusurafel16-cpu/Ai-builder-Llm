apps/web/dist
data
*.db
*.db-journal
*.log
.env
.env.local
.venv
venv
.idea
.vscode
.DS_Store
docs
tests
scripts
infrastructure
Dockerfile.*
docker-compose.yml
railway.toml
nixpacks.toml
README.md
AGENTS.md
*.md
