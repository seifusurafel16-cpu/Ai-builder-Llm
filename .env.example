# ---- AI Platform environment configuration ----
# Copy to .env for local dev. For Railway, set the "Required / Variables" via the
# Railway dashboard (see railway.md). Railway auto-injects PORT and DATABASE_URL.

# ---- Railway-injected (do NOT set locally unless testing) ----
# PORT: injected by Railway. Locally defaults to 8000.
# PORT=8000

# ---- Database ----
# Local dev (zero external deps):
DATABASE_URL=sqlite:///data/ai_platform.db
# Railway: add the Railway PostgreSQL plugin and reference its DATABASE_URL.
# The app accepts `postgresql://` or `postgres://` (normalized to psycopg2).
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# ---- Auth / JWT ----
# REQUIRED in production. Set a stable random string, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If unset, an ephemeral one is generated per boot (sessions invalidate on redeploy).
SECRET_KEY=dev-only-change-me-in-production

# ---- Storage (persistent) ----
# Mount a Railway Volume to /data and keep these defaults. Locally uses ./data.
STORAGE_DIR=/data/storage
CHECKPOINT_DIR=/data/checkpoints
TOKENIZER_DIR=/data/tokenizers
LOG_DIR=/data/logs

# ---- Worker ----
# Run the training worker inside the API process (single-service deploy).
# Set false to run a dedicated worker service (see Procfile).
RUN_INLINE_WORKER=true

# ---- Training / hardware ----
DEFAULT_DEVICE=auto
WORKER_POLL_SECONDS=1.0
SSE_HEARTBEAT_SECONDS=15

# ---- CORS ----
CORS_ORIGINS=*
